[node name="NPCQuestGiver" parent="Fongo" unique_id=1038261128 instance=ExtResource("12_0dawo")]
npc_name = "Fongo"
npc_id = "fongo"
quest_id = "algo_raro"
quest_title = "Algo anda mal"
quest_description = "Fongo te pide que hables con Munfy, el aprendiz del Dr.Ergot.
Fongo ha estado muy enfermo, pero ha notado que desde que toma la medicina del Dr Ergot, todo ha ido empeorando. 
Al principio la medicina parecia ayudar, pero ahora ... todo ha cambiado."
quest_objective = "Habla con Munfy, es un poco cascarrabias, pero es buen hongo."
target_npc_id = "munfy"
prerequisite_quest_id = "askfor_fongo"
completion_type = "Hablar con NPC"
greeting_available = "Oyee ¿Podría pedirte un favor?"
greeting_in_progress = "Por favor, ve a hablar con Munfy."
greeting_can_deliver = "¿Hola? Ahhh ... vienes de parte de Funry."
greeting_after_delivered = "Funry es tan buen amigo, ¡Siempre se preocupa por mi!"
dialogue_offer = "¿Has visto que hay mucho hongos enfermos? No solo yo. No se mucho de medicina y esas cosas, pero creo que la medicina del Dr. Ergot no está funcionando bien. Por eso creo que podrías ir con Munfy, el tambien sabe mucho de medicina, quizás el tambien nota lo mismo que yo."
dialogue_in_progress = "Por favor, busca a Munfy, vive solo, es la casa más al este de la ciudad, antes del elevador que da hacia el laboratorio del Dr.Ergot"
dialogue_locked = "Snif, snif"
dialogue_waiting_delivery = "Hmmm ... me siento muy mal."
dialogue_can_deliver = "¿Quien eres? 
Ohhh, vale, vale ... conque Funry te ha enviado conmigo. 
Ey, verás, hay algo raro que esta pasando, no se porque pero ... desde que tomé la medicina del Dr Ergot ... me siento más mal que antes. "
dialogue_after_delivered = "Snif... dile a Funry que gracias por preocuparse. Cuando puedas, vuelve conmigo, quisiera hablarte un poco más. "

