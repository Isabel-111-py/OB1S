[node name="Quest_1_Buscar_un_ingrediente" parent="Munfy" unique_id=2083446390 instance=ExtResource("12_0dawo")]
npc_name = "Munfy"
npc_id = "munfy"
quest_id = "ingrediente_munfy"
quest_title = "Una nueva medicina"
quest_description = "Munfy cree que algo anda mal con la medicina del Dr.Ergot y cree que puede hacer un antidoto alternativo para los honguipobladores y quizás con esto pueda impresionar a su maestro, el Dr.Ergot."
quest_objective = "Consigue una Planta Medicinal para Munfy"
target_npc_id = "munfy"
prerequisite_quest_id = "algo_raro"
required_item_id = "planta_medicinal"
greeting_available = "¡Hey! ¿Qué haces por aquí?"
greeting_in_progress = "¿Aún no encuentras la Planta Medicinal?"
greeting_ready = "¡Has vuelto con la planta!"
dialogue_offer = "Quizás pueda hacer un antidoto alternativo para ayudar a los honguiciudadanos."
dialogue_in_progress = "Por favor busca la planta medicinal, quizás la encuentres hacia el oeste, cerca de la entrada al Bosque."
dialogue_ready = "¡Increíble, conseguiste la Planta! Déjame extraer sus esencias... dame un momento."
dialogue_waiting_delivery = "Mmmm, sin tan solo tuviera la planta medicinal ..."
dialogue_can_deliver = "Quizás el viejo Fongo tenga razón, aunque es raro que mi maestro falle haciendo una medicina, quizás esta sea mi oportunidad..."
btn_accept_text = "Buscar Planta"
btn_deliver_text = "Hablar con Munfy"
btn_complete_text = "Entregar Planta"

[node name="Quest_2_CurarFongo" parent="Munfy" unique_id=1263346110 instance=ExtResource("12_0dawo")]
npc_name = "Munfy"
npc_id = "munfy"
quest_id = "curar_fongo"
quest_title = "Hay que probar la medicina."
quest_description = "Munfy quiere que le lleves el antidoto alternativo a Fongo, si funciona, quiere que regreses a contarle."
quest_objective = "Dale la medicina a Fongo"
target_npc_id = "fongo"
return_to_giver = true
return_objective = "Informale a Munfy que su medicina ha funcionado en Fongo."
greeting_available = "¡Debemos probar la medicina!"
