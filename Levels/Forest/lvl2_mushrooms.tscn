[node name="NPCQuestGiver" parent="Funry" unique_id=2025773518 instance=ExtResource("12_0dawo")]
npc_name = "Funry"
npc_id = "funry"
quest_id = "askfor_fongo"
quest_title = "Hechale un ojo a Fongo ... ¿ojo? ¿Qué supone que tienes tu?"
quest_description = "Funry quiere que visites a su amigo Fongo. "
quest_objective = "Habla con Fongo"
target_npc_id = "fongo"
return_to_giver = true
return_objective = "Regresa con Funry para contarle sobre Fongo"
prerequisite_quest_id = "medicina_funry"
completion_type = "Hablar con NPC"
greeting_available = "Eyyyy, señor raro"
greeting_in_progress = "Estoy tan preocupado por mi amihongui"
greeting_ready = "¡Gracias por visitir a Fongo!"
greeting_completed = "Que extraño ..."
greeting_waiting_delivery = "Cof cof... me siento muy débil..."
greeting_can_deliver = "¡Traes la medicina del DrErgot! ¡Por favor dámela!"
greeting_after_delivered = "¡Gracias a la medicina ya me siento mucho mejor!"
dialogue_offer = "Señor raro, como verás hemos estado un poquis enfermos, Ergot dice que es por unas esporas que no nos hacen bien. Estoy muy preocupado por Fongo, y quisiera que lo visitaras y me dijeras como está."
dialogue_in_progress = "Pobre Fongo, ¿estará mejor?"
dialogue_ready = "Hmmm, que extraño. Conque Fongo esta malito, ¿Acaso el Dr Ergot no le dio la medicina?"
dialogue_completed = "Vale, vale. Tienes cosas que hacer. ¿Puedes acompañar a Fongo?"
dialogue_locked = "Pium, pim"
dialogue_waiting_delivery = "Cof cof... no me quedan fuerzas... El DrErgot me dijo que me mandaría una medicina con alguien de buen corazón..."
dialogue_can_deliver = "Oh, por fin. Has traido medicina para mi, muchas gracias."
dialogue_after_delivered = "¡Me siento un poco mejor! Ve a avisarle al DrErgot, dale las gracias de mi parte."

