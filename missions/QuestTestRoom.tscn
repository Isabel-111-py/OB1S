[node name="QuestReceiverFunry" parent="FunryNPC" unique_id=1053722440 instance=ExtResource("7_qgiver")]
npc_role = "Receiver (Solo recibe ítem / entrega)"
npc_name = "Funry"
npc_id = "funry"
quest_id = ""
greeting_waiting_delivery = "Cof cof... me siento muy débil..."
greeting_can_deliver = "¡Traes la medicina del DrErgot! ¡Por favor dámela!"
greeting_after_delivered = "¡Gracias a la medicina ya me siento mucho mejor!"
dialogue_waiting_delivery = "Cof cof... no me quedan fuerzas... El DrErgot me dijo que me mandaría una medicina con alguien de buen corazón..."
dialogue_can_deliver = "¡Oh! ¿Esa es la medicina que envió el DrErgot? ¡Muchísimas gracias, señor de metal! (Funry bebe la medicina y su sombrerillo recupera su brillo saludable). ¡Me siento con fuerzas otra vez! Por favor, regresa con el DrErgot e infórmale que ya estoy a salvo."
dialogue_after_delivered = "¡Me siento lleno de vida otra vez! Ve a avisarle al DrErgot para que sepa que su fórmula funcionó a la perfección."

