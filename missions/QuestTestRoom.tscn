quest_title = "Medicina para Funry"
quest_description = "El sabio DrErgot necesita que lleves una medicina urgente a Funry, que está enfermo al otro lado del claro."
quest_objective = "Entrega la medicina a Funry"
target_npc_id = "funry"
return_to_giver = true
return_objective = "Regresa con DrErgot para informarle"
grant_item_on_accept = &"medicina_funry"
