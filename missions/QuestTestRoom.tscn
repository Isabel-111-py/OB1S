grant_item_desc = "Extracto de micelio medicinal formulado para curar las esporas de Funry."
required_item_id = "medicina_funry"
consume_item_on_complete = true
reward_ammo_slot = 0
reward_ammo_amount = 5
reward_upgrade_id = "receta_ergot"
reward_upgrade_name = "Receta del DrErgot"
reward_upgrade_desc = "Distintivo médico entregado por el DrErgot en agradecimiento por salvar a Funry."
greeting_available = "¿Me ayuda, señor de metal?"
greeting_in_progress = "¿Pudiste encontrar a Funry?"
greeting_ready = "¡Has vuelto! ¿Cómo está Funry?"
greeting_completed = "¡Muchas gracias por ayudar a Funry, señor de metal!"
dialogue_offer = "¡Hola señor de metal! Funry está muy débil por culpa de las esporas oscuras. Preparé este frasco de medicina, pero no puedo dejar el consultorio. ¿Podrías llevársela con urgencia?"
dialogue_in_progress = "Por favor apresúrate en llevarle la medicina a Funry. Lo encontrarás a la derecha del claro."
dialogue_ready = "¡Excelente noticia! Sabía que podía confiar en ti. Funry ya está fuera de peligro. ¡Toma esta recompensa por tu gran labor!"
dialogue_completed = "¡Funry y yo siempre te recordaremos con cariño, señor de metal!"

